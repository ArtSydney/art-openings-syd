# Serper API key (Google search)
SERPER_API_KEY=your_serper_key_here

# Discord webhook (optional - unset to disable notifications)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Instagram (optional - for scraping @sydneyartfinder)
# Get this from Firefox DevTools > Storage > Cookies > instagram.com > sessionid
INSTAGRAM_SESSION_ID=your_sessionid_cookie_value
